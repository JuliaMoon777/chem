<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. API Endpoints
    RewriteRule ^api/news/?$ api/news.php [L,QSA]
    RewriteRule ^api/careers/?$ api/careers.php [L,QSA]
    RewriteRule ^api/auth/?$ api/auth.php [L,QSA]
    RewriteRule ^api/upload/?$ api/upload.php [L,QSA]

    # 2. Uploads folder
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^uploads/ - [L]

    # 3. Dynamic SSR SEO for News and Careers (serves SSR injected metadata)
    RewriteRule ^aktualnosci(/.*)?$ api/ssr.php [L,QSA]
    RewriteRule ^kariera(/.*)?$ api/ssr.php [L,QSA]

    # 4. Standard SPA Fallback for existing static files
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Default Fallback
    RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
